# URL base del backend (FastAPI)
VITE_API_URL=http://localhost:8000

# Catálogo y checkout sin login (API /api/v1/public). Poné false para volver al modo solo autenticado.
VITE_USE_PUBLIC_API=true

# Slug del local (multi-tenant). Ej: demo
VITE_TENANT_SLUG=

# Public Key de MercadoPago (para el frontend — Brick de pago)
# Obtenela en: https://www.mercadopago.com.ar/developers/panel
VITE_MP_PUBLIC_KEY=TEST-xxxxxxxxxxxxxxxxxxxx
